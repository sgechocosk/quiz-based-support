{
  "name": "quiz-based-support",
  "displayName": "quiz-based-support",
  "description": "System understanding support in a quiz format.",
  "version": "0.1.0",
  "publisher": "local-dev",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "quiz-based-support.setApiKey",
        "title": "Quiz Support: Set OpenAI API Key"
      },
      {
        "command": "quiz-based-support.rebuildIndex",
        "title": "Quiz Support: Rebuild Code Index"
      },
      {
        "command": "quiz-based-support.clearIndex",
        "title": "Quiz Support: Clear Code Index"
      },
      {
        "command": "quiz-based-support.showLearningLog",
        "title": "Quiz Support: Show Learning Log"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "quiz-support-sidebar",
          "title": "Quiz Support",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "quiz-support-sidebar": [
        {
          "type": "webview",
          "id": "quiz-support-chat",
          "name": "AI Code Quiz"
        }
      ]
    },
    "configuration": {
      "title": "Quiz Support",
      "properties": {
        "quizSupport.learnerLevel": {
          "type": "string",
          "default": "intermediate",
          "enum": ["beginner", "intermediate", "advanced"],
          "enumDescriptions": [
            "初学者・学生: 用語を言い換え、基本の仕組みから一歩ずつ説明します。",
            "実務エンジニア: 一般的な用語はそのまま使い、設計意図や責務の分担を中心に説明します。",
            "上級: 独自の仕組み・一般的でない技術・設計上のトレードオフを中心に扱います。"
          ],
          "description": "学習者のレベル。出題の難しさ・用語の扱い・解説の細かさが変わります(サイドバーからも変更できます)。"
        },
        "quizSupport.model": {
          "type": "string",
          "default": "gpt-5-mini",
          "description": "調査・出題・採点補助に使うチャットモデル名。"
        },
        "quizSupport.reasoningEffort": {
          "type": "string",
          "default": "auto",
          "enum": ["auto", "default", "none", "minimal", "low", "medium", "high"],
          "description": "推論強度。auto: 通常は未指定で送り、「ツールと reasoning_effort は併用不可」と返すモデル(gpt-6-luna 等)では自動で none に切り替えて再試行。default: 常に未指定。それ以外: その値を常に送信。"
        },
        "quizSupport.embeddingModel": {
          "type": "string",
          "default": "text-embedding-3-small",
          "description": "意味検索(埋め込み)のモデル名。変更すると既存ベクトルは破棄されます。"
        },
        "quizSupport.baseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "OpenAI互換APIのベースURL(Azure OpenAI・OpenRouter・Ollama等の互換エンドポイントも指定可)。"
        },
        "quizSupport.maxAgentSteps": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 20,
          "description": "調査フェーズでLLMが呼べるツールの最大回数。増やすと精度が上がる代わりに時間とトークンが増えます。"
        },
        "quizSupport.minSimilarity": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 1,
          "description": "意味検索のみでヒットしたコードに課すコサイン類似度の下限。"
        },
        "quizSupport.semanticGrading": {
          "type": "boolean",
          "default": true,
          "description": "厳密一致しなかった回答を、LLMで『同じ動作か』判定して救済する(不正解の回答ごとにAPIを1回使います)。"
        },
        "quizSupport.structureQuestions": {
          "type": "boolean",
          "default": true,
          "description": "言語サーバ(LSP)の事実から、呼び出し関係・定義場所の選択式問題を追加する。"
        },
        "quizSupport.autoEmbedMaxTokens": {
          "type": "number",
          "default": 100000,
          "description": "ファイル変更時に自動で埋め込みを更新する上限トークン数。超える場合は手動更新になります。"
        },
        "quizSupport.maxFiles": {
          "type": "number",
          "default": 3000,
          "description": "インデックス対象の最大ファイル数。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "package:vsix": "vsce package --allow-missing-repository --skip-license",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "test:unit": "npm run compile-tests && node --test \"out/test/unit/*.test.js\"",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "web-tree-sitter": "^0.26.9"
  }
}
